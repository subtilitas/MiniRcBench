# Doxygen configuration for MiniRcBench.
# Only non-default settings are listed; run `doxygen -u Doxyfile` to expand.
#
#   doxygen                       -> docs/html/index.html
#   doxygen 2>&1 | grep -i warn   -> anything that needs attention

PROJECT_NAME           = "MiniRcBench"
PROJECT_BRIEF          = "Bidirectional DShot ESC tester for the Waveshare RP2350-Touch-LCD-2 and -2.8"
OUTPUT_DIRECTORY       = docs
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# --- input ---------------------------------------------------------------
# Every translation unit lives in src/, including main.cpp -- there is no longer
# a sketch root to keep an .ino at. test/ holds host-side stubs whose whole job
# is to imitate headers we do not own, so documenting them is meaningless.
# docs/design is referenced from config.h and from README.md, so it belongs
# in the input set -- otherwise those links point at files Doxygen has never
# seen and the @ref checker cannot verify them.
INPUT                  = src README.md docs/design
EXCLUDE                = docs test
FILE_PATTERNS          = *.h *.c *.cpp *.md
RECURSIVE              = YES

# README.md is the front page. The architecture write-up in src/main.cpp is
# a @page, not a second @mainpage -- two mainpages is an error, not a merge.
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES

# Give markdown headings the same anchors GitHub does, so a link written as
# (#am32-esc-configuration) resolves in both places. Doxygen's own scheme is
# autotoc_md<N>, which no README can link to by hand and which renumbers
# whenever a heading is added above it.
#
# Needs doxygen >= 1.9.8. An older one does not merely ignore this -- it warns
# about the unknown tag, and the docs job fails on any warning at all, so the
# version is printed there to make that obvious rather than puzzling.
MARKDOWN_ID_STYLE      = GITHUB

# README references docs/ui-preview.png; without this the image is reported
# missing even though the file is right there.
IMAGE_PATH             = docs

# --- what to document ----------------------------------------------------
EXTRACT_ALL            = NO      # NO so missing docs surface as warnings
EXTRACT_STATIC         = YES     # most of this firmware is file-static
EXTRACT_PRIVATE        = YES
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = NO

# Both OFF deliberately, and neither is laziness.
#
# WARN_IF_UNDOCUMENTED fires on every file-static too, which here means ~70
# internals like s_scroll and Z_RPM_Y1. A comment saying "scroll position" on
# s_scroll informs nobody; the pressure to add them would produce noise that
# buries the comments that do carry information.
#
# WARN_NO_PARAMDOC demands a @param line per argument even where the brief
# already names them inline with @p -- gfxRect(x, y, w, h, c) does not need
# five more lines to be understood.
#
# What actually matters -- public API in headers being documented, @param names
# matching their signatures, no dangling @ref -- is enforced precisely by
# test/check_docs.py, which runs in CI. Doxygen is left to report real
# structural problems, such as two @mainpage blocks.
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# --- presentation --------------------------------------------------------
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES
SORT_MEMBER_DOCS       = NO      # keep declaration order; it is meaningful here

# --- preprocessor --------------------------------------------------------
# Document the portrait branch of the LCD_ROTATION conditionals rather than
# leaving GFX_W / GFX_H undefined.
#
# BOARD_TOUCH_CST816D is predefined for the same reason: each touch driver is
# wrapped in a whole-file #ifdef, so with neither macro set both would document
# as empty files. Only one is set because defining both would produce two
# definitions of touchInit() and touchPoll() for Doxygen to reconcile. The
# CST328 driver's @file block is outside its guard and still renders; to read
# its internals, swap the macro here and regenerate. Both board pin maps are
# unconditional and always document.
#
# EXPAND_ONLY_PREDEF stays YES: the settings table in am32_eeprom.cpp is built
# from F_BOOL/F_RAW/F_SCALED/F_ENUM macros, and expanding those inline turns a
# readable table into forty lines of brace soup.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = LCD_ROTATION=0 \
                         AM32_PUSH_PULL_TX=1 \
                         AM32_FORCE_LOW_JUMP=0 \
                         SERIAL_TELEMETRY=1 \
                         BOARD_TOUCH_CST816D=1 \
                         __DOXYGEN__
